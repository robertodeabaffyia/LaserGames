# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=EventOS <noreply@eventoslaser.com>

# Vonage (WhatsApp via Messages API)
VONAGE_API_KEY=your-vonage-api-key
VONAGE_API_SECRET=your-vonage-api-secret
VONAGE_WHATSAPP_FROM=14157386170
# Optional: override to test against the Messages API Sandbox
# (https://messages-sandbox.nexmo.com). Leave unset in production.
VONAGE_API_HOST=

# Cron jobs (leave empty to allow unauthenticated calls in dev)
CRON_SECRET=your-cron-secret

# Supabase service role (server-only — used by WhatsApp/Mercado Pago webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Webhooks (WhatsApp inbound + Mercado Pago). Same fail-closed policy as CRON_SECRET.
# Configure the provider URLs as .../api/whatsapp/webhook?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=your-webhook-secret

# Mercado Pago (seña de reservas Escape Room)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# Public base URL of the deployed app (for MP notification_url)
APP_BASE_URL=https://your-app.vercel.app
